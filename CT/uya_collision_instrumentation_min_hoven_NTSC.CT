    <CheatEntry>
      <ID>600</ID>
      <Description>"[Lua] Decode state + resurrectWait (Hoven NTSC)"</Description>
      <Active>1</Active>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return 'assert(true)' end

local bxor, band, rshift
if bit32 then
  bxor = bit32.bxor
  band = bit32.band
  rshift = bit32.rshift
elseif bit then
  bxor = bit.bxor
  band = bit.band
  rshift = bit.rshift
else
  local floor = math.floor
  local function u32(n) return n % 4294967296 end
  function band(a, b)
    a = u32(a); b = u32(b)
    local res, bitv = 0, 1
    for _ = 0, 31 do
      local aa = a % 2
      local bb = b % 2
      if aa == 1 and bb == 1 then res = res + bitv end
      a = floor(a / 2)
      b = floor(b / 2)
      bitv = bitv * 2
    end
    return u32(res)
  end
  function bxor(a, b)
    a = u32(a); b = u32(b)
    local res, bitv = 0, 1
    for _ = 0, 31 do
      local aa = a % 2
      local bb = b % 2
      if aa ~= bb then res = res + bitv end
      a = floor(a / 2)
      b = floor(b / 2)
      bitv = bitv * 2
    end
    return u32(res)
  end
  function rshift(a, n)
    return floor(u32(a) / (2 ^ n))
  end
end

local function mapAddr(a)
  if a &gt;= 0x20000000 then return a end
  return a + 0x20000000
end

local function readU8Unmapped(a)
  local t = readBytes(mapAddr(a), 1, true)
  if not t or t[1] == nil then return 0 end
  return t[1]
end

local RAND_STATE = 0x003BF5A1
local RAND_WEAPON = 0x003A97C1

local function deobf(srcUnmapped, mode)
  local i = srcUnmapped
  local iv = readU8Unmapped(i)
  if mode == 0 and iv == 0 then return 0 end

  local maxv, step, mult, rand
  if mode == 0 then
    maxv = 0x28; step = 5; mult = 0xFF; rand = RAND_STATE
  elseif mode == 1 then
    maxv = 0x18; step = 3; mult = 0xD1; rand = RAND_WEAPON
  elseif mode == 2 then
    maxv = 0x18; step = 3; mult = 0xFF; rand = RAND_STATE
  else
    return 0
  end

  local data = {}
  local n = 0
  local idx = 1
  local baseOff = band(i - iv, 7)
  while n &lt; maxv do
    local offset = baseOff + n
    local src = rand + iv + band(offset, 7) * mult
    data[idx] = readU8Unmapped(src)
    idx = idx + 1
    n = n + step
  end

  local addr = data[1] + data[2]*0x100 + data[3]*0x10000 + data[4]*0x1000000
  local val  = data[5] + data[6]*0x100 + data[7]*0x10000 + data[8]*0x1000000
  local resAddr = bxor(val, bxor(addr, i))
  local resVal = rshift(resAddr, 16)

  if mode == 0 then return band(resAddr, 0xFFFFFFFF) end
  if mode == 1 then return band(resVal, 0xFF) end
  return band(resVal, 0xFFFFFFFF)
end

if _G.uyaDecMin and _G.uyaDecMin.timer then _G.uyaDecMin.timer.destroy() end
if _G.uyaDecMin and _G.uyaDecMin.base then
  pcall(unregisterSymbol, 'uya_dec_min_base')
  pcall(unregisterSymbol, 'uya_dec_min_state')
  pcall(unregisterSymbol, 'uya_dec_min_reswait')
  pcall(unregisterSymbol, 'uya_dec_min_hotspot_index')
  pcall(unregisterSymbol, 'uya_dec_min_isvisible')
  pcall(unregisterSymbol, 'uya_dec_min_wait_const')
  pcall(unregisterSymbol, 'uya_dec_min_heartbeat')
end

local base = allocateMemory(0x200)
registerSymbol('uya_dec_min_base', base)
registerSymbol('uya_dec_min_state', base + 0x00)
registerSymbol('uya_dec_min_reswait', base + 0x04)
registerSymbol('uya_dec_min_hotspot_index', base + 0x08)
registerSymbol('uya_dec_min_isvisible', base + 0x0C)
registerSymbol('uya_dec_min_wait_const', base + 0x10)
registerSymbol('uya_dec_min_heartbeat', base + 0x1FC)

local t = createTimer(nil, false)
t.Interval = 33
t.OnTimer = function()
  local p = readInteger(0x202496B0)
  if not p or p == 0 then return end

  writeInteger(base + 0x1FC, 0xC0DEC0DE)
  writeInteger(base + 0x00, deobf(p + 0x19E4, 0))
  writeInteger(base + 0x04, deobf(p + 0x031C, 2))
  writeSmallInteger(base + 0x08, readSmallInteger(mapAddr(p + 0x0370)) or 0)

  local inv = readU8Unmapped(p + 0x1A0A)
  writeInteger(base + 0x0C, (inv == 0) and 1 or 0)
  writeInteger(base + 0x10, 0x90)
end
t.Enabled = true

_G.uyaDecMin = { timer = t, base = base }
return 'assert(true)'
[DISABLE]
{$lua}
if syntaxcheck then return 'assert(true)' end
if _G.uyaDecMin and _G.uyaDecMin.timer then _G.uyaDecMin.timer.destroy() end
if _G.uyaDecMin and _G.uyaDecMin.base then
  pcall(unregisterSymbol, 'uya_dec_min_base')
  pcall(unregisterSymbol, 'uya_dec_min_state')
  pcall(unregisterSymbol, 'uya_dec_min_reswait')
  pcall(unregisterSymbol, 'uya_dec_min_hotspot_index')
  pcall(unregisterSymbol, 'uya_dec_min_isvisible')
  pcall(unregisterSymbol, 'uya_dec_min_wait_const')
  pcall(unregisterSymbol, 'uya_dec_min_heartbeat')
end
_G.uyaDecMin = nil
return 'assert(true)'
</AssemblerScript>
