        <CheatEntry><ID>900101</ID><Description>"decoded state (mode 0)"</Description><ShowAsHex>1</ShowAsHex><VariableType>4 Bytes</VariableType><Address>uya_dec_state</Address></CheatEntry>
        <CheatEntry><ID>900102</ID><Description>"decoded hitPoints (mode 0)"</Description><VariableType>4 Bytes</VariableType><Address>uya_dec_hitpoints</Address></CheatEntry>
        <CheatEntry><ID>900103</ID><Description>"decoded availableGadgets (mode 1)"</Description><ShowAsHex>1</ShowAsHex><VariableType>4 Bytes</VariableType><Address>uya_dec_gadgets</Address></CheatEntry>
        <CheatEntry><ID>900104</ID><Description>"decoded heartbeat (0xC0DEC0DE when active)"</Description><ShowAsHex>1</ShowAsHex><VariableType>4 Bytes</VariableType><Address>uya_dec_heartbeat</Address></CheatEntry>
