    <CheatEntry>
      <ID>900100</ID>
      <Description>"[Auto] Decoded (Lua) - Hoven NTSC obfuscation tables"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return 'assert(true)' end
if not bit32 then
  showMessage('bit32 library not available in CE Lua; decoder disabled')
  return 'assert(true)'
end
local bxor = bit32.bxor
local band = bit32.band
local rshift = bit32.rshift
local function mapAddr(a)
  if a &gt;= 0x20000000 then return a end
  return a + 0x20000000
end
local function readU8Unmapped(a)
  local t = readBytes(mapAddr(a), 1, true)
  if not t or t[1] == nil then return 0 end
  return t[1]
end
local RAND_STATE = 0x003BF5A1
local RAND_WEAPON = 0x003A97C1
local function deobf(srcUnmapped, mode)
  local i = srcUnmapped
  local iv = readU8Unmapped(i)
  if mode == 0 and iv == 0 then return 0 end
  local maxv, step, mult, rand
  if mode == 0 then
    maxv = 0x28; step = 5; mult = 0xFF; rand = RAND_STATE
  elseif mode == 1 then
    maxv = 0x18; step = 3; mult = 0xD1; rand = RAND_WEAPON
  elseif mode == 2 then
    maxv = 0x18; step = 3; mult = 0xFF; rand = RAND_STATE
  else
    return 0
  end
  local data = {}
  local n = 0
  local idx = 1
  local baseOff = band(i - iv, 7)
  while n &lt; maxv do
    local offset = baseOff + n
    local src = rand + iv + band(offset, 7) * mult
    data[idx] = readU8Unmapped(src)
    idx = idx + 1
    n = n + step
  end
  local addr = data[1] + data[2]*0x100 + data[3]*0x10000 + data[4]*0x1000000
  local val  = data[5] + data[6]*0x100 + data[7]*0x10000 + data[8]*0x1000000
  local resAddr = bxor(val, bxor(addr, i))
  local resVal = rshift(resAddr, 16)
  if mode == 0 then return band(resAddr, 0xFFFFFFFF) end
  if mode == 1 then return band(resVal, 0xFF) end
  return band(resVal, 0xFFFFFFFF)
end
if _G.uyaDec and _G.uyaDec.timer then _G.uyaDec.timer.destroy() end
if _G.uyaDec and _G.uyaDec.base then
  pcall(unregisterSymbol, 'uya_dec_state')
  pcall(unregisterSymbol, 'uya_dec_hitpoints')
  pcall(unregisterSymbol, 'uya_dec_gadgets')
  pcall(unregisterSymbol, 'uya_dec_heartbeat')
  pcall(unregisterSymbol, 'uya_dec_base')
end
local base = allocateMemory(0x200)
registerSymbol('uya_dec_base', base)
registerSymbol('uya_dec_state', base + 0x00)
registerSymbol('uya_dec_hitpoints', base + 0x04)
registerSymbol('uya_dec_gadgets', base + 0x08)
registerSymbol('uya_dec_heartbeat', base + 0x1FC)
local t = createTimer(nil, false)
t.Interval = 33
t.OnTimer = function()
  local p = readInteger(0x202496B0)
  if not p or p == 0 then return end
  writeInteger(base + 0x1FC, 0xC0DEC0DE)
  writeInteger(base + 0x00, deobf(p + 0x19E4, 0))
  writeInteger(base + 0x04, deobf(p + 0x2476, 0))
  writeInteger(base + 0x08, deobf(p + 0x1A41, 1))
  for i=0,6 do writeInteger(base + 0x20 + (i*4), deobf(p + 0x1A32 + i, 1)) end
  for i=0,11 do writeInteger(base + 0x40 + (i*4), deobf(p + 0x1A53 + i, 1)) end
  for i=0,11 do writeInteger(base + 0x80 + (i*4), deobf(p + 0x1A63 + i, 1)) end
end
t.Enabled = true
_G.uyaDec = { timer = t, base = base }
return 'assert(true)'
[DISABLE]
{$lua}
if syntaxcheck then return 'assert(true)' end
if _G.uyaDec and _G.uyaDec.timer then _G.uyaDec.timer.destroy() end
if _G.uyaDec and _G.uyaDec.base then
  pcall(unregisterSymbol, 'uya_dec_state')
  pcall(unregisterSymbol, 'uya_dec_hitpoints')
  pcall(unregisterSymbol, 'uya_dec_gadgets')
  pcall(unregisterSymbol, 'uya_dec_heartbeat')
  pcall(unregisterSymbol, 'uya_dec_base')
end
_G.uyaDec = nil
return 'assert(true)'
</AssemblerScript>
